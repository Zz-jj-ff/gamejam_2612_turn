; GIRL // HEAD — procedural android girl head.
; Zero external assets: every mesh, material, shader is code.

config_version=5

[application]

config/name="GIRL // HEAD"
config/description="Code-generated android girl head. No imported meshes or textures."
run/main_scene="res://scenes/studio.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/bg_color=Color(0.010, 0.011, 0.016, 1)
boot_splash/show_image=false

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/size/window_width_override=1600
window/size/window_height_override=900
window/stretch/mode="canvas_items"
window/vsync/vsync_mode=1

[rendering]

renderer/rendering_method="forward_plus"
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/use_debanding=true
textures/default_filters/anisotropic_filtering_level=3
environment/defaults/default_clear_color=Color(0.004, 0.005, 0.008, 1)
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=2
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=2

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="character"